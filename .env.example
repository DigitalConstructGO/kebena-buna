# Drizzle
# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Messages (SMS through GeezSMS, email through SMTP). The dev server only pretends to send
# unless NOTIFY_DRY_RUN=false.
SMS_KEY=""
SMTP_URL=""
SMTP_FROM="Kebena Coffee <hello@kebena.coffee>"
NOTIFY_DRY_RUN=""
# Set to false on any extra server instance that should not run the background jobs.
JOBS_ENABLED=""

# Ticket QR codes are signed with a key made from this (any long random string). Changing it voids
# every QR already issued. Unset: made from BETTER_AUTH_SECRET.
TICKET_QR_SECRET=""

# Chapa. Unset: web orders wait for staff to take payment and no "Pay now" button is shown.
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""
